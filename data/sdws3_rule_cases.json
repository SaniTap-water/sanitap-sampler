{
 "note": "Test cases for the SDWS 3 creditable rule (data/sdws3_rule.json). Byte-identical in sanitap-water-report and sanitap-sampler; each repository's own implementation must give exactly these verdicts (tools/test_sdws3_creditable.py there, test/sdws3-rule.test.js here). Values are keyed by the rule's parameter keys; date is the result date (WS7.10), submitted the submission time.",
 "cases": [
  {"name": "a clean result is creditable",
   "results": [{"wp": "1", "code": "A-1", "date": "2025-05-01", "values": {"ecoli": 0, "arsenic": 2, "fluoride": 0.3, "turbidity": 1}}],
   "expect": {"1": {"creditable": true, "failing": []}}},
  {"name": "E. coli above 0 fails",
   "results": [{"wp": "2", "code": "A-2", "date": "2025-08-14", "values": {"ecoli": 50, "arsenic": 0, "fluoride": 0.2, "turbidity": 0}}],
   "expect": {"2": {"creditable": false, "failing": ["ecoli"]}}},
  {"name": "fluoride at the kit maximum of 1.5 fails (over-range)",
   "results": [{"wp": "3", "code": "A-3", "date": "2025-08-15", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 1.5, "turbidity": 0}}],
   "expect": {"3": {"creditable": false, "failing": ["fluoride"]}}},
  {"name": "fluoride just under the maximum passes",
   "results": [{"wp": "4", "code": "A-4", "date": "2025-08-15", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 1.49, "turbidity": 0}}],
   "expect": {"4": {"creditable": true, "failing": []}}},
  {"name": "arsenic at 10 passes, above 10 fails",
   "results": [{"wp": "5", "code": "A-5", "date": "2025-06-01", "values": {"ecoli": 0, "arsenic": 10, "fluoride": 0, "turbidity": 0}},
               {"wp": "6", "code": "A-6", "date": "2025-06-01", "values": {"ecoli": 0, "arsenic": 10.5, "fluoride": 0, "turbidity": 0}}],
   "expect": {"5": {"creditable": true, "failing": []}, "6": {"creditable": false, "failing": ["arsenic"]}}},
  {"name": "turbidity at 5 passes, above 5 fails",
   "results": [{"wp": "7", "code": "A-7", "date": "2025-06-01", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 5}},
               {"wp": "8", "code": "A-8", "date": "2025-06-01", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 6}}],
   "expect": {"7": {"creditable": true, "failing": []}, "8": {"creditable": false, "failing": ["turbidity"]}}},
  {"name": "the named exception: turbidity 11 on response Cathy_MadAvance-D5V5UQ is ignored",
   "results": [{"wp": "742894851", "code": "Cathy_MadAvance-D5V5UQ", "date": "2025-04-26", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0.1, "turbidity": 11}}],
   "expect": {"742894851": {"creditable": true, "failing": []}}},
  {"name": "the exception covers turbidity only, and that response only",
   "results": [{"wp": "742894851", "code": "Cathy_MadAvance-OTHER", "date": "2025-05-26", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0.1, "turbidity": 11}},
               {"wp": "9", "code": "Cathy_MadAvance-D5V5UQ-X", "date": "2025-04-26", "values": {"ecoli": 3, "arsenic": 0, "fluoride": 0.1, "turbidity": 11}}],
   "expect": {"742894851": {"creditable": false, "failing": ["turbidity"]}, "9": {"creditable": false, "failing": ["ecoli", "turbidity"]}}},
  {"name": "only the latest result counts: a later passing retest restores the point",
   "results": [{"wp": "10", "code": "A-10a", "date": "2025-08-14", "values": {"ecoli": 50, "arsenic": 0, "fluoride": 0, "turbidity": 0}},
               {"wp": "10", "code": "A-10b", "date": "2026-02-01", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 0}}],
   "expect": {"10": {"creditable": true, "failing": []}}},
  {"name": "only the latest result counts: a later failing result removes the point",
   "results": [{"wp": "11", "code": "A-11a", "date": "2025-08-14", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 0}},
               {"wp": "11", "code": "A-11b", "date": "2026-02-01", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 1.5, "turbidity": 0}}],
   "expect": {"11": {"creditable": false, "failing": ["fluoride"]}}},
  {"name": "latest is by result date, not by submission order",
   "results": [{"wp": "12", "code": "A-12a", "date": "2026-01-10", "submitted": "2026-01-11T00:00:00Z", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 0}},
               {"wp": "12", "code": "A-12b", "date": "2025-12-01", "submitted": "2026-03-01T00:00:00Z", "values": {"ecoli": 4, "arsenic": 0, "fluoride": 0, "turbidity": 0}}],
   "expect": {"12": {"creditable": true, "failing": []}}},
  {"name": "on the same result date, the later submission counts",
   "results": [{"wp": "13", "code": "A-13a", "date": "2025-07-01", "submitted": "2025-07-01T08:00:00Z", "values": {"ecoli": 0, "arsenic": 0, "fluoride": 0, "turbidity": 0}},
               {"wp": "13", "code": "A-13b", "date": "2025-07-01", "submitted": "2025-07-02T08:00:00Z", "values": {"ecoli": 2, "arsenic": 0, "fluoride": 0, "turbidity": 0}}],
   "expect": {"13": {"creditable": false, "failing": ["ecoli"]}}},
  {"name": "a draft result is ignored",
   "results": [{"wp": "14", "code": "A-14", "date": "2025-07-01", "status": "draft", "values": {"ecoli": 9, "arsenic": 0, "fluoride": 0, "turbidity": 0}}],
   "expect": {}},
  {"name": "a blank parameter does not fail",
   "results": [{"wp": "15", "code": "A-15", "date": "2025-07-01", "values": {"ecoli": 0, "arsenic": null, "fluoride": 0.4}}],
   "expect": {"15": {"creditable": true, "failing": []}}}
 ]
}
